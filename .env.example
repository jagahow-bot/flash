# =============================================================================
# FLASH — Environment variables
# Copy to .env.local for local dev.
# On Render: set the same keys in Dashboard → Environment (see docs/DEPLOY.md).
# =============================================================================

# --- Firebase (client) — NEXT_PUBLIC_* are embedded at build time ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server only) ---
# Private key: paste the full key; use literal \n for newlines in Render dashboard
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Firestore seed (local only — npm run seed) ---
SEED_ADMIN_UID=
SEED_ARTIST_UID=

# --- Google Gemini (AI brief generation + studio profile extraction for enrich-studio API) ---
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Image model for npm run generate:demo-images (defaults to gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- OpenAI (optional fallback for demo image generation) ---
# npm run generate:demo-images
OPENAI_API_KEY=

# --- Public app URL ---
# Production: https://your-domain.com (no trailing slash)
# Render sets RENDER_EXTERNAL_URL automatically; set this when using a custom domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Analytics 4 (optional — omit locally to disable tracking) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-J37ZXCG926

# --- Transactional email (Resend — https://resend.com) ---
RESEND_API_KEY=
EMAIL_FROM=FLASH <hello@ink-flash.com>

# --- Platform admin (developer dashboard at /platform) ---
# Comma-separated emails with full platform admin access (in addition to users with role platform_admin)
PLATFORM_ADMIN_EMAILS=

# --- Service-to-service prospect import (yoga-scraper → POST /api/platform/prospect-studios) ---
# When set, scripts may authenticate with header: x-platform-import-key: <key>
# Or Authorization: Bearer <key>
PLATFORM_IMPORT_API_KEY=

# --- Prospect studio preview JWT (optional; falls back to hashed Firebase admin key in dev) ---
PREVIEW_JWT_SECRET=

# --- Stripe billing (usage-based — https://stripe.com) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook endpoint: https://your-domain.com/api/webhooks/stripe
# Events: invoice.paid, invoice.payment_failed, customer.subscription.deleted, checkout.session.completed
